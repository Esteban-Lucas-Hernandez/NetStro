---
/**
 * TaskForm.astro — Formulario de Crear / Editar Tarea
 * ----------------------------------------------------
 * Componente puramente de presentacion (HTML + CSS).
 * NO contiene logica JavaScript propia: el evento submit
 * y la gestion de estado la maneja el <script> de index.astro,
 * que accede a los elementos de este formulario por su id.
 *
 * Modos de uso:
 *   - Modo CREAR: el campo oculto #task-id esta vacio.
 *                 El submit llama a POST /api/tasks.
 *   - Modo EDITAR: el campo oculto #task-id tiene el id de la tarea.
 *                  El submit llama a PUT /api/tasks/{id}.
 *
 * IDs expuestos que usa index.astro:
 *   #task-form-section  — Seccion contenedora (para hacer scroll)
 *   #form-title         — Titulo dinamico "Nueva Tarea" / "Editar #n"
 *   #form-alert         — Div para mensajes de exito/error
 *   #task-form          — El elemento <form>
 *   #task-id            — Input oculto que guarda el id en modo edicion
 *   #task-title         — Input del titulo
 *   #task-description   — Textarea de la descripcion
 *   #task-completed     — Checkbox isCompleted
 *   #btn-submit         — Boton de envio (tiene .btn-text y .spinner internos)
 *   #btn-cancel         — Boton para cancelar la edicion
 */
---

<!-- Seccion contenedora con clase .card para el estilo de tarjeta -->
<section class="card" id="task-form-section">

  <!-- Titulo dinamico: lo actualiza JS segun el modo (crear/editar) -->
  <h2 id="form-title">Nueva Tarea</h2>

  <!-- Alerta de formulario: oculta por defecto.
       JS le agrega la clase 'success' o 'error' segun el resultado. -->
  <div id="form-alert" class="alert hidden" role="alert"></div>

  <!--
    novalidate: desactivamos la validacion nativa del navegador
    para poder mostrar nuestros propios mensajes de error
    con el estilo del tema.
  -->
  <form id="task-form" novalidate>

    <!-- Campo oculto: almacena el id de la tarea cuando estamos en modo EDITAR.
         Esta vacio en modo CREAR. JS lo lee para decidir si llama POST o PUT. -->
    <input type="hidden" id="task-id" value="" />

    <!-- ── CAMPO: TÍTULO ──────────────────────────────────── -->
    <div class="field">
      <!-- El asterisco (*) indica que el campo es obligatorio -->
      <label for="task-title">
        Título <span class="required">*</span>
      </label>
      <!--
        maxlength: limite de caracteres para el titulo.
        required: marca el campo como obligatorio para el HTML (aunque usamos novalidate).
        autocomplete="off": evita sugerencias del historial del navegador.
      -->
      <input
        type="text"
        id="task-title"
        name="title"
        placeholder="Ej. Aprender Astro y .NET"
        maxlength="200"
        required
        autocomplete="off"
      />
    </div>

    <!-- ── CAMPO: DESCRIPCIÓN ─────────────────────────────── -->
    <div class="field">
      <label for="task-description">Descripción</label>
      <textarea
        id="task-description"
        name="description"
        rows="3"
        placeholder="Describe brevemente la tarea..."
        maxlength="1000"
      ></textarea>
    </div>

    <!-- ── CAMPO: IS COMPLETED (checkbox personalizado) ──── -->
    <!--
      El checkbox nativo esta oculto (display:none en CSS).
      En su lugar usamos .checkbox-custom, un <span> estilizado
      que actua como el control visual. El estado real se sigue
      leyendo de input[type="checkbox"]#task-completed.
    -->
    <div class="field field--checkbox">
      <label class="checkbox-label">
        <input type="checkbox" id="task-completed" name="isCompleted" />
        <!-- El span .checkbox-custom es el cuadrado visual personalizado -->
        <span class="checkbox-custom"></span>
        Marcar como completada
      </label>
    </div>

    <!-- ── ACCIONES DEL FORMULARIO ────────────────────────── -->
    <div class="form-actions">
      <!--
        Boton principal: envia el formulario.
        Contiene dos hijos:
          .btn-text  → texto visible ("Guardar Tarea" / "Actualizar Tarea")
          .spinner   → icono de carga animado (oculto por defecto)
        JS alterna su visibilidad segun el estado de la peticion.
      -->
      <button type="submit" class="btn btn--primary" id="btn-submit">
        <span class="btn-text">Guardar Tarea</span>
        <span class="spinner hidden"></span>
      </button>

      <!--
        Boton Cancelar: solo visible en modo EDITAR.
        JS lo muestra (style.display='') al cargar una tarea para editar
        y lo oculta (style.display='none') al resetear el formulario.
      -->
      <button type="button" class="btn btn--ghost" id="btn-cancel">
        Cancelar
      </button>
    </div>

  </form>
</section>

<style>
  /* ── TARJETA CONTENEDORA ──────────────────────────────────────
     Usa las variables CSS definidas en Layout.astro (:root).
     box-shadow da profundidad visual al componente. */
  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow);
  }

  /* ── TITULO DE SECCION ────────────────────────────────────────
     El pseudo-elemento ::before genera la barra vertical de color
     que aparece a la izquierda del titulo (decoracion). */
  h2 {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  h2::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 1.1em;
    background: var(--color-primary); /* barra indigo decorativa */
    border-radius: 2px;
  }

  /* ── CAMPO DE FORMULARIO ──────────────────────────────────────
     Cada campo agrupa label + input/textarea en columna. */
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  /* El asterisco de campo obligatorio en rojo */
  .required { color: var(--color-danger); }

  /* ── INPUTS Y TEXTAREA ────────────────────────────────────────
     Fondo ligeramente mas claro que la card para dar profundidad.
     Transicion suave en el borde al enfocar. */
  input[type="text"],
  textarea {
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) - 2px);
    color: var(--color-text);
    padding: 0.625rem 0.875rem;
    transition: border-color var(--transition), box-shadow var(--transition);
    width: 100%;
    resize: vertical; /* el usuario puede redimensionar verticalmente el textarea */
  }

  /* Al enfocar: borde primario + anillo de foco semi-transparente */
  input[type="text"]:focus,
  textarea:focus {
    outline: none; /* quitamos el outline por defecto del navegador */
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(99,102,241,0.2); /* anillo indigo suave */
  }

  /* Placeholder mas tenue que el texto normal */
  input[type="text"]::placeholder,
  textarea::placeholder { color: var(--color-text-muted); opacity: 0.6; }

  /* ── CHECKBOX PERSONALIZADO ───────────────────────────────────
     Tecnica: ocultamos el input nativo y lo reemplazamos visualmente
     con .checkbox-custom. El estado (:checked) controla el estilo. */
  .field--checkbox { flex-direction: row; align-items: center; }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
    color: var(--color-text);
    font-size: 0.9rem;
    user-select: none; /* evita que el texto se seleccione al hacer click */
  }

  /* Ocultamos el checkbox nativo pero lo mantenemos accesible */
  .checkbox-label input[type="checkbox"] { display: none; }

  /* Cuadrado visual que reemplaza al checkbox nativo */
  .checkbox-custom {
    width: 18px;
    height: 18px;
    border: 2px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-surface-2);
    flex-shrink: 0; /* no se encoge si el texto es largo */
    transition: background var(--transition), border-color var(--transition);
    position: relative; /* necesario para posicionar el checkmark ::after */
  }

  /* Estado MARCADO: fondo indigo */
  .checkbox-label input[type="checkbox"]:checked + .checkbox-custom {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  /* Checkmark (palomita) dibujado con CSS puro usando ::after */
  .checkbox-label input[type="checkbox"]:checked + .checkbox-custom::after {
    content: '';
    position: absolute;
    left: 4px;
    top: 1px;
    width: 6px;
    height: 10px;
    border: 2px solid white;
    border-top: none;
    border-left: none;
    transform: rotate(45deg); /* forma de palomita */
  }

  /* ── ACCIONES DEL FORMULARIO ──────────────────────────────────
     Fila de botones con separacion y ajuste en pantallas pequenas. */
  .form-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.25rem;
    flex-wrap: wrap; /* en movil los botones se apilan */
  }

  /* ── ESTILOS BASE DE BOTON ────────────────────────────────────
     Todos los botones comparten esta clase; las variantes
     (--primary, --ghost) agregan color especifico. */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.25rem;
    border-radius: calc(var(--radius) - 2px);
    font-weight: 500;
    border: none;
    transition: background var(--transition), transform var(--transition), opacity var(--transition);
  }

  /* Mini escala al presionar: feedback tactil visual */
  .btn:active { transform: scale(0.97); }

  /* Boton principal: fondo indigo */
  .btn--primary { background: var(--color-primary); color: white; }
  .btn--primary:hover { background: var(--color-primary-hover); }
  .btn--primary:disabled { opacity: 0.6; cursor: not-allowed; } /* durante loading */

  /* Boton fantasma: sin fondo, solo borde */
  .btn--ghost {
    background: transparent;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
  }
  .btn--ghost:hover { background: var(--color-surface-2); color: var(--color-text); }

  /* ── ALERTA DE RESULTADO ──────────────────────────────────────
     El div #form-alert empieza con clase 'hidden'.
     JS le agrega 'success' o 'error' y quita 'hidden'. */
  .alert {
    padding: 0.7rem 1rem;
    border-radius: calc(var(--radius) - 2px);
    font-size: 0.875rem;
    margin-bottom: 1rem;
    border-left: 3px solid; /* barra de color lateral segun tipo */
  }
  .alert.success {
    background: rgba(34,197,94,0.1);
    border-color: var(--color-success);
    color: var(--color-success);
  }
  .alert.error {
    background: rgba(239,68,68,0.1);
    border-color: var(--color-danger);
    color: var(--color-danger);
  }

  /* Clase utilitaria: oculta cualquier elemento */
  .hidden { display: none !important; }

  /* ── SPINNER DE CARGA ─────────────────────────────────────────
     Circulo que gira mientras se espera la respuesta del servidor.
     Se muestra/oculta con la clase 'hidden' mediante JS. */
  .spinner {
    width: 14px;
    height: 14px;
    border: 2px solid rgba(255,255,255,0.3); /* borde tenue base */
    border-top-color: white;                 /* solo el arco superior es blanco */
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }

  /* Animacion de rotacion infinita */
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
