---
/**
 * index.astro — Pagina principal de NetStro
 * ------------------------------------------
 * Es el punto de entrada de la aplicacion.
 * Responsabilidades:
 *   1. Componer el HTML de la pagina usando los componentes:
 *        Layout     → plantilla base (head, body, CSS global)
 *        TaskForm   → formulario crear/editar
 *        TaskViewer → buscador + detalle de tarea
 *   2. Contener TODO el JavaScript del cliente en un <script>.
 *      En Astro, el bloque <script> se empaqueta y ejecuta en el navegador.
 *      Desde aqui se controla la logica de:
 *        - Validacion del formulario
 *        - Peticiones fetch a la API
 *        - Renderizado dinamico del detalle
 *        - Manejo de estados de carga y mensajes de feedback
 */
import Layout from '../layouts/Layout.astro';
import TaskForm from '../components/TaskForm.astro';
import TaskViewer from '../components/TaskViewer.astro';
---

<Layout title="NetStro — Gestión de Tareas">
  <div class="app">

    <!-- ══════════════════════════════════════════════════
         HEADER — Barra de navegacion superior fija
         Contiene el logotipo de la app y el indicador
         de que la API esta disponible en localhost:5000.
    ══════════════════════════════════════════════════ -->
    <header class="app-header">
      <div class="header-inner">

        <!-- Logotipo: icono + nombre + subtitulo de la app -->
        <div class="header-brand">
          <span class="brand-icon">⚡</span>
          <span class="brand-name">NetStro</span>
          <span class="brand-sub">Task Manager</span>
        </div>

        <!-- Badge que indica el estado de la API (punto verde animado) -->
        <div class="header-badge">
          <span class="badge-dot"></span> <!-- circulo verde pulsante -->
          API: localhost:5000
        </div>

      </div>
    </header>

    <!-- ══════════════════════════════════════════════════
         MAIN — Contenido principal
         Grid de dos columnas:
           Izquierda → TaskForm   (crear/editar tarea)
           Derecha   → TaskViewer (buscar/ver/eliminar tarea)
    ══════════════════════════════════════════════════ -->
    <main class="app-main">
      <div class="grid">
        <!-- Columna izquierda: formulario de creacion y edicion -->
        <TaskForm />

        <!-- Columna derecha: buscador por ID y detalle de la tarea -->
        <TaskViewer />
      </div>
    </main>

    <!-- ══════════════════════════════════════════════════
         FOOTER — Pie de pagina
    ══════════════════════════════════════════════════ -->
    <footer class="app-footer">
      <span>NetStro &copy; 2026 · Astro + .NET Core</span>
    </footer>

  </div>
</Layout>

<!-- ══════════════════════════════════════════════════════════════
     SCRIPT DEL CLIENTE
     ──────────────────────────────────────────────────────────────
     En Astro, el contenido de <script> se ejecuta en el NAVEGADOR
     (no en el servidor). Astro lo empaqueta con Vite, por lo que
     podemos usar TypeScript directamente.

     ARQUITECTURA:
       1. Constantes y utilidades
       2. Referencias a elementos del DOM
       3. Estado de la aplicacion
       4. Funcion de render del detalle
       5. Manejadores de eventos (uno por cada accion CRUD)
══════════════════════════════════════════════════════════════════ -->
<script>

  // ─────────────────────────────────────────────────────────────
  // 1. CONSTANTES
  // ─────────────────────────────────────────────────────────────

  /** URL base de la API del backend. Debe coincidir con el puerto de .NET. */
  const API = 'http://localhost:5000';

  // ─────────────────────────────────────────────────────────────
  // 2. UTILIDADES
  //    Funciones de ayuda reutilizadas en varios manejadores.
  // ─────────────────────────────────────────────────────────────

  /**
   * Formatea una cadena ISO 8601 a una fecha legible en espanol (Mexico).
   * Ejemplo: "2026-08-22T16:30:00Z" → "22 ago. 2026, 11:30 a. m."
   * Si la cadena es invalida, devuelve el original como fallback.
   */
  function formatDate(iso: string): string {
    if (!iso) return '—';
    try {
      return new Intl.DateTimeFormat('es-MX', {
        dateStyle: 'medium',
        timeStyle: 'short',
      }).format(new Date(iso));
    } catch {
      return iso; // fallback: devolvemos el string original si falla el parseo
    }
  }

  /**
   * Muestra un mensaje de alerta dentro del elemento `el`.
   * @param el      - El div de alerta del DOM
   * @param message - Texto a mostrar
   * @param type    - 'success' (verde) | 'error' (rojo)
   */
  function showAlert(el: HTMLElement, message: string, type: 'success' | 'error') {
    el.textContent = message;
    el.className = `alert ${type}`; // reemplaza todas las clases
    el.classList.remove('hidden');  // hace visible el div
  }

  /**
   * Oculta y limpia un div de alerta.
   */
  function hideAlert(el: HTMLElement) {
    el.classList.add('hidden');
    el.textContent = '';
    el.className = 'alert hidden';
  }

  /**
   * Activa/desactiva el estado de carga en un boton.
   * Cuando loading=true: deshabilita el boton, atenua el texto y muestra el spinner.
   * Cuando loading=false: restaura el boton a su estado normal.
   *
   * @param btn     - El elemento <button>
   * @param loading - true para activar el loading, false para desactivarlo
   */
  function setLoading(btn: HTMLButtonElement, loading: boolean) {
    const text    = btn.querySelector('.btn-text') as HTMLElement | null;
    const spinner = btn.querySelector('.spinner') as HTMLElement | null;
    btn.disabled = loading;
    if (text)    text.style.opacity = loading ? '0.6' : '1';
    if (spinner) spinner.classList.toggle('hidden', !loading);
  }

  // ─────────────────────────────────────────────────────────────
  // 3. REFERENCIAS AL DOM
  //    Capturamos todos los elementos que manipularemos desde JS.
  //    Usamos el operador ! (non-null assertion) porque sabemos
  //    que existen en el HTML renderizado por los componentes.
  // ─────────────────────────────────────────────────────────────

  // -- Elementos de TaskForm.astro --
  const formSection = document.getElementById('task-form-section')!;        // seccion contenedora
  const form        = document.getElementById('task-form') as HTMLFormElement;
  const formTitle   = document.getElementById('form-title')!;               // titulo dinamico
  const formAlert   = document.getElementById('form-alert') as HTMLElement; // alerta del form
  const inputId     = document.getElementById('task-id') as HTMLInputElement;        // campo oculto id
  const inputTitle  = document.getElementById('task-title') as HTMLInputElement;     // campo titulo
  const inputDesc   = document.getElementById('task-description') as HTMLTextAreaElement; // textarea
  const inputDone   = document.getElementById('task-completed') as HTMLInputElement; // checkbox
  const btnSubmit   = document.getElementById('btn-submit') as HTMLButtonElement;    // boton guardar
  const btnCancel   = document.getElementById('btn-cancel') as HTMLButtonElement;    // boton cancelar

  // -- Elementos de TaskViewer.astro --
  const searchIdInput = document.getElementById('search-id') as HTMLInputElement;    // input del ID a buscar
  const btnSearch     = document.getElementById('btn-search') as HTMLButtonElement;  // boton Buscar
  const searchAlert   = document.getElementById('search-alert') as HTMLElement;      // alerta del buscador
  const taskDetail    = document.getElementById('task-detail')!;                     // contenedor del detalle
  const actionAlert   = document.getElementById('action-alert') as HTMLElement;      // alerta de acciones

  // -- Elementos dentro del detalle de la tarea --
  const detailStatus  = document.getElementById('detail-status-badge')!; // badge completada/pendiente
  const detailId      = document.getElementById('detail-id')!;           // span con el ID
  const detailCreated = document.getElementById('detail-created')!;      // span con la fecha
  const detailTitle   = document.getElementById('detail-title')!;        // h3 con el titulo
  const detailDesc    = document.getElementById('detail-description')!;  // p con la descripcion
  const btnEditTask   = document.getElementById('btn-edit-task') as HTMLButtonElement;
  const btnToggle     = document.getElementById('btn-toggle-complete') as HTMLButtonElement;
  const btnDelete     = document.getElementById('btn-delete-task') as HTMLButtonElement;

  // ─────────────────────────────────────────────────────────────
  // 4. ESTADO DE LA APLICACION
  // ─────────────────────────────────────────────────────────────

  /**
   * Tipo que representa una tarea como la devuelve el backend.
   * Replica la interfaz TaskItem de api.ts (no podemos importarla
   * en el bloque <script> de Astro con el modo actual de bundling).
   */
  interface Task {
    id: number;
    title: string;
    description: string;
    isCompleted: boolean;
    createdAt: string;
  }

  /**
   * Tarea actualmente mostrada en el panel de detalle.
   * null si no hay ninguna tarea cargada.
   * Se actualiza cada vez que el usuario busca, edita o cambia el estado.
   */
  let currentTask: Task | null = null;

  // ─────────────────────────────────────────────────────────────
  // 5. RENDER DEL DETALLE
  // ─────────────────────────────────────────────────────────────

  /**
   * Rellena el panel de detalle con los datos de una tarea y lo hace visible.
   * Esta funcion es el unico punto de actualizacion del detalle; todos los
   * manejadores que reciben datos frescos del servidor la llaman.
   *
   * @param task - Objeto Task con los datos del backend
   */
  function renderTask(task: Task) {
    // Actualizamos el estado global
    currentTask = task;

    // Badge de estado: texto y clase CSS segun isCompleted
    detailStatus.textContent = task.isCompleted ? '✓ Completada' : '⏳ Pendiente';
    detailStatus.className   = `task-status ${task.isCompleted ? 'completed' : 'pending'}`;

    // Metadatos: ID y fecha formateada
    detailId.textContent      = String(task.id);
    detailCreated.textContent = formatDate(task.createdAt);

    // Contenido principal
    detailTitle.textContent = task.title;
    detailDesc.textContent  = task.description || '(Sin descripción)';

    // El texto del boton toggle cambia segun el estado actual
    btnToggle.textContent = task.isCompleted ? '↩ Marcar pendiente' : '✔ Marcar completada';

    // Mostramos el contenedor (estaba oculto con .hidden)
    taskDetail.classList.remove('hidden');

    // Limpiamos cualquier alerta previa del area de acciones
    hideAlert(actionAlert);
  }

  // ─────────────────────────────────────────────────────────────
  // 6. MANEJADOR: SUBMIT DEL FORMULARIO (CREAR o ACTUALIZAR)
  // ─────────────────────────────────────────────────────────────

  /**
   * Evento submit del formulario.
   * Decide si crear (POST) o actualizar (PUT) segun el valor de inputId.
   * - inputId vacio  → modo CREAR  → POST /api/tasks
   * - inputId con ID → modo EDITAR → PUT  /api/tasks/{id}
   */
  form.addEventListener('submit', async (e) => {
    e.preventDefault();      // evitamos la recarga de pagina por defecto
    hideAlert(formAlert);    // limpiamos alertas previas

    // Validacion manual: el titulo es obligatorio
    const title = inputTitle.value.trim();
    if (!title) {
      showAlert(formAlert, 'El título es obligatorio.', 'error');
      inputTitle.focus(); // llevamos el foco al campo vacio
      return;
    }

    // Determinamos el modo segun si hay un ID en el campo oculto
    const isEditMode = inputId.value !== '';
    setLoading(btnSubmit, true); // activamos el spinner del boton

    try {
      let res: Response;

      if (isEditMode) {
        // ── MODO EDITAR: PUT /api/tasks/{id} ──────────────────
        // El payload DEBE incluir el id (el backend lo requiere en el body)
        const payload = {
          id:          Number(inputId.value),
          title,
          description: inputDesc.value.trim(),
          isCompleted: inputDone.checked,
        };
        res = await fetch(`${API}/api/tasks/${payload.id}`, {
          method:  'PUT',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify(payload),
        });

      } else {
        // ── MODO CREAR: POST /api/tasks ────────────────────────
        // El payload NO incluye id ni createdAt (los genera el backend)
        const payload = {
          title,
          description: inputDesc.value.trim(),
          isCompleted: inputDone.checked,
        };
        res = await fetch(`${API}/api/tasks`, {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify(payload),
        });
      }

      // Si el servidor respondio con error (4xx, 5xx)
      if (!res.ok) {
        const msg = await res.text();
        showAlert(formAlert, `Error ${res.status}: ${msg || res.statusText}`, 'error');
        return;
      }

      if (isEditMode) {
        // Edicion exitosa: mostramos mensaje y refrescamos el detalle
        showAlert(formAlert, '✓ Tarea actualizada correctamente.', 'success');

        // Si la tarea editada es la que esta visible en el viewer,
        // la refrescamos con un GET para mostrar los datos actualizados
        if (currentTask && currentTask.id === Number(inputId.value)) {
          const refreshed = await fetch(`${API}/api/tasks/${inputId.value}`);
          if (refreshed.ok) {
            const updated: Task = await refreshed.json();
            renderTask(updated);
          }
        }
      } else {
        // Creacion exitosa: parseamos la respuesta y mostramos la tarea
        const created: Task = await res.json();
        showAlert(
          formAlert,
          `✓ Tarea creada con ID ${created.id}. Puedes buscarla en el panel derecho.`,
          'success'
        );

        // Mostramos automaticamente la tarea recien creada en el viewer
        renderTask(created);
        searchIdInput.value = String(created.id); // actualizamos el campo de busqueda
      }

      resetForm(); // limpiamos el formulario tras cualquier operacion exitosa

    } catch {
      // Error de red (servidor apagado, sin internet, etc.)
      showAlert(formAlert, 'No se pudo conectar con el servidor.', 'error');
    } finally {
      // Siempre desactivamos el loading, sea exito o error
      setLoading(btnSubmit, false);
    }
  });

  // ─────────────────────────────────────────────────────────────
  // 7. MANEJADOR: CANCELAR EDICION
  // ─────────────────────────────────────────────────────────────

  /**
   * El boton Cancelar solo aparece en modo EDITAR.
   * Al hacer click: limpia el formulario y vuelve al modo CREAR.
   */
  btnCancel.addEventListener('click', () => {
    resetForm();
    hideAlert(formAlert);
  });

  /**
   * Restablece el formulario al estado inicial (modo CREAR).
   * - Limpia todos los campos con form.reset()
   * - Vacia el campo oculto del ID
   * - Restaura el titulo y el texto del boton
   * - Oculta el boton Cancelar
   */
  function resetForm() {
    form.reset();                              // limpia todos los inputs del form
    inputId.value = '';                        // quitamos el ID (salimos del modo editar)
    formTitle.textContent = 'Nueva Tarea';     // titulo de vuelta al modo crear
    (btnSubmit.querySelector('.btn-text') as HTMLElement).textContent = 'Guardar Tarea';
    btnCancel.style.display = 'none';          // ocultamos Cancelar
  }

  // El boton Cancelar comienza oculto (solo aparece en modo editar)
  btnCancel.style.display = 'none';

  // ─────────────────────────────────────────────────────────────
  // 8. MANEJADOR: BUSCAR TAREA POR ID
  // ─────────────────────────────────────────────────────────────

  // Buscar al hacer click en el boton
  btnSearch.addEventListener('click', () => searchTask());

  // Buscar tambien al presionar Enter dentro del input de ID
  searchIdInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') searchTask();
  });

  /**
   * Busca una tarea por su ID numerico.
   * Hace GET /api/tasks/{id} y muestra el resultado en el panel de detalle.
   */
  async function searchTask() {
    const idVal = searchIdInput.value.trim();

    // Validacion: el ID debe ser un numero positivo
    if (!idVal || Number(idVal) < 1) {
      showAlert(searchAlert, 'Ingresa un ID válido (número entero positivo).', 'error');
      return;
    }

    // Preparamos la UI para la carga
    hideAlert(searchAlert);
    taskDetail.classList.add('hidden'); // ocultamos el detalle previo mientras cargamos
    setLoading(btnSearch, true);

    try {
      const res = await fetch(`${API}/api/tasks/${idVal}`); // GET implicito

      if (!res.ok) {
        if (res.status === 404) {
          // La tarea no existe → mensaje especifico de "no encontrada"
          showAlert(searchAlert, `No existe una tarea con ID ${idVal}.`, 'error');
        } else {
          // Otro error del servidor (500, 400, etc.)
          const msg = await res.text();
          showAlert(searchAlert, `Error ${res.status}: ${msg || res.statusText}`, 'error');
        }
        return;
      }

      // Exito: parseamos y renderizamos
      const task: Task = await res.json();
      hideAlert(searchAlert); // limpiamos si habia un error previo
      renderTask(task);

    } catch {
      showAlert(searchAlert, 'No se pudo conectar con el servidor.', 'error');
    } finally {
      setLoading(btnSearch, false);
    }
  }

  // ─────────────────────────────────────────────────────────────
  // 9. MANEJADOR: EDITAR (cargar tarea en el formulario)
  // ─────────────────────────────────────────────────────────────

  /**
   * Al hacer click en "Editar" en el panel de detalle:
   * 1. Carga los datos de la tarea actual en los campos del formulario.
   * 2. Cambia el titulo del form a "Editar Tarea #n".
   * 3. Muestra el boton Cancelar.
   * 4. Hace scroll suave hasta el formulario y enfoca el campo titulo.
   * No hace ninguna peticion HTTP; la peticion se hace en el submit.
   */
  btnEditTask.addEventListener('click', () => {
    if (!currentTask) return; // seguridad: no deberia ocurrir

    // Rellenamos cada campo del formulario con los datos de la tarea actual
    inputId.value     = String(currentTask.id);    // activa el modo EDITAR
    inputTitle.value  = currentTask.title;
    inputDesc.value   = currentTask.description;
    inputDone.checked = currentTask.isCompleted;

    // Actualizamos la UI del formulario para indicar modo EDITAR
    formTitle.textContent = `Editar Tarea #${currentTask.id}`;
    (btnSubmit.querySelector('.btn-text') as HTMLElement).textContent = 'Actualizar Tarea';
    btnCancel.style.display = ''; // mostramos el boton Cancelar

    // Limpiamos mensajes previos del formulario
    hideAlert(formAlert);

    // Navegacion: scroll hasta el formulario con animacion suave
    formSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    inputTitle.focus(); // enfocamos el primer campo editable
  });

  // ─────────────────────────────────────────────────────────────
  // 10. MANEJADOR: TOGGLE COMPLETADA / PENDIENTE
  // ─────────────────────────────────────────────────────────────

  /**
   * Alterna el estado isCompleted de la tarea actual.
   * Hace PUT /api/tasks/{id} con isCompleted invertido,
   * y luego refresca el detalle con un GET para mostrar el estado actualizado.
   */
  btnToggle.addEventListener('click', async () => {
    if (!currentTask) return;

    // Construimos el payload con isCompleted invertido respecto al estado actual
    const updated = {
      id:          currentTask.id,
      title:       currentTask.title,
      description: currentTask.description,
      isCompleted: !currentTask.isCompleted, // <-- la inversion
    };

    btnToggle.disabled = true; // deshabilitamos mientras esperamos

    try {
      const res = await fetch(`${API}/api/tasks/${updated.id}`, {
        method:  'PUT',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify(updated),
      });

      if (!res.ok) {
        const msg = await res.text();
        showAlert(actionAlert, `Error ${res.status}: ${msg || res.statusText}`, 'error');
        return;
      }

      // Refrescamos el detalle con un GET para mostrar el dato actualizado del backend
      const refreshed = await fetch(`${API}/api/tasks/${updated.id}`);
      if (refreshed.ok) {
        const task: Task = await refreshed.json();
        renderTask(task); // actualiza el badge, el boton toggle, etc.
        showAlert(
          actionAlert,
          task.isCompleted
            ? '✓ Tarea marcada como completada.'
            : '✓ Tarea marcada como pendiente.',
          'success'
        );
      }

    } catch {
      showAlert(actionAlert, 'No se pudo conectar con el servidor.', 'error');
    } finally {
      btnToggle.disabled = false; // siempre rehabilitamos el boton
    }
  });

  // ─────────────────────────────────────────────────────────────
  // 11. MANEJADOR: ELIMINAR TAREA
  // ─────────────────────────────────────────────────────────────

  /**
   * Elimina permanentemente la tarea actual.
   * 1. Pide confirmacion al usuario con window.confirm (dialogo nativo).
   * 2. Si confirma, hace DELETE /api/tasks/{id}.
   * 3. Oculta el detalle y limpia el estado.
   */
  btnDelete.addEventListener('click', async () => {
    if (!currentTask) return;

    // Pedimos confirmacion explicita antes de una accion destructiva
    const confirmed = window.confirm(
      `¿Estás seguro de que deseas eliminar la tarea "${currentTask.title}" (ID: ${currentTask.id})? Esta acción no se puede deshacer.`
    );
    if (!confirmed) return; // el usuario cancelo → no hacemos nada

    setLoading(btnDelete, true);

    try {
      const res = await fetch(`${API}/api/tasks/${currentTask.id}`, {
        method: 'DELETE', // sin body
      });

      if (!res.ok) {
        const msg = await res.text();
        showAlert(actionAlert, `Error ${res.status}: ${msg || res.statusText}`, 'error');
        return;
      }

      // Eliminacion exitosa:
      taskDetail.classList.add('hidden'); // ocultamos el detalle
      currentTask = null;                 // limpiamos el estado global
      searchIdInput.value = '';           // vaciamos el campo de busqueda
      // Mostramos el mensaje de exito en el area del buscador (el detalle esta oculto)
      showAlert(searchAlert, '✓ Tarea eliminada correctamente.', 'success');

    } catch {
      showAlert(actionAlert, 'No se pudo conectar con el servidor.', 'error');
    } finally {
      setLoading(btnDelete, false);
    }
  });

</script>

<style>
  /* ── CONTENEDOR RAIZ ──────────────────────────────────────────
     Usamos flexbox en columna para que el footer siempre quede
     al fondo, aunque el contenido sea corto. */
  .app {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* ══════════════════════════════════════════════════
     HEADER
  ══════════════════════════════════════════════════ */

  .app-header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    position: sticky;       /* se queda fijo al hacer scroll */
    top: 0;
    z-index: 100;           /* encima del contenido al hacer scroll */
    backdrop-filter: blur(12px); /* efecto de cristal si hay contenido detras */
  }

  /* Contenedor interno del header: limita el ancho y centra el contenido */
  .header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0.875rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between; /* logotipo a la izquierda, badge a la derecha */
    gap: 1rem;
  }

  /* Logotipo: icono + nombre + subtitulo */
  .header-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .brand-icon {
    font-size: 1.4rem;
    line-height: 1;
  }

  /* Nombre con gradiente de color indigo a violeta */
  .brand-name {
    font-size: 1.25rem;
    font-weight: 700;
    background: linear-gradient(90deg, #6366f1, #a78bfa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.02em;
  }

  /* Etiqueta "Task Manager" en forma de pill */
  .brand-sub {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 400;
    padding: 0.15rem 0.5rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }

  /* Badge "API: localhost:5000" con punto verde pulsante */
  .header-badge {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
  }

  /* Circulo verde que pulsa para indicar que la API esta activa */
  .badge-dot {
    width: 6px;
    height: 6px;
    background: var(--color-success);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite; /* animacion de latido */
  }

  /* Animacion de latido: oscila entre opacidad 1 y 0.4 */
