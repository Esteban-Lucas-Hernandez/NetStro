---
/**
 * index.astro — Página Principal (Dashboard NetStro)
 * --------------------------------------------------
 * Punto de entrada limpio: ensambla los componentes modulares,
 * importa el CSS del dashboard y ejecuta el script de cliente.
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Metrics from '../components/Metrics.astro';
import Controls from '../components/Controls.astro';
import TaskModal from '../components/TaskModal.astro';
import Footer from '../components/Footer.astro';
import '../styles/dashboard.css';
---

<Layout title="NetStro — Dashboard de Tareas">
  <div class="app">

    <!-- Header Principal -->
    <Header />

    <!-- Contenido del Dashboard -->
    <main class="app-main">
      <!-- Notificación Toast -->
      <div id="toast-notification" class="toast hidden"></div>

      <!-- Métricas y Estadísticas -->
      <Metrics />

      <!-- Buscador y Filtros -->
      <Controls />

      <!-- Cuadrícula / Estado de Carga / Estado Vacío de Tareas -->
      <section class="tasks-container">
        <div id="tasks-loading" class="tasks-grid">
          <div class="skeleton-card"></div>
          <div class="skeleton-card"></div>
          <div class="skeleton-card"></div>
        </div>

        <div id="tasks-grid" class="tasks-grid hidden"></div>

        <div id="tasks-empty" class="empty-state hidden">
          <div class="empty-icon">🍃</div>
          <h3 id="empty-title">Sin tareas aún</h3>
          <p id="empty-subtitle">Comienza agregando tu primera tarea con el botón verde "+ Nueva Tarea".</p>
          <button id="btn-empty-create" class="btn-primary-sm">Crear Tarea Ahora</button>
        </div>
      </section>
    </main>

    <!-- Modal Flotante de Creación / Edición -->
    <TaskModal />

    <!-- Pie de Página -->
    <Footer />

  </div>
</Layout>

<!-- Script de Cliente Modular -->
<script>
  import { initDashboard } from '../scripts/dashboard';
  initDashboard();
</script>
